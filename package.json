  "peerDependencies": { "vue": ">=3.0.0" },
  "dependencies": { "@vizr/browser": "^0.1.0" },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.4.0",
    "vitest": "^1.0.0"
  }
}
